{
  "effects": {
    "print-quote": {
      "bridge": {
        "name": "prodigi",
        "targets": [
          "cloudflare",
          "k8s"
        ],
        "simulated": true
      },
      "credential": {
        "header": "X-API-Key",
        "secret": "PRODIGI_API_KEY"
      },
      "edgeOrigin": {
        "secret": "PRODIGI_ORIGIN"
      },
      "table": "print_order",
      "field": "status",
      "state": "quoting",
      "onDone": "converting",
      "onError": "quote_failed",
      "row": [
        "id"
      ],
      "key": [
        "id"
      ],
      "idempotent": true,
      "attempts": 5,
      "handler": "effects/print-quote.js"
    },
    "print-quote-br": {
      "bridge": {
