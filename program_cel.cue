				view: "public.portable_shape_valid(view, '{\"kind\":\"object\",\"fields\":{\"flipped\":{\"kind\":\"string\",\"enumValues\":[\"no\",\"yes\"]},\"status\":{\"kind\":\"string\",\"enumValues\":[\"playing\",\"fullscreen\",\"login\",\"completed\"]}}}'::jsonb)"
			}
			enums: {
				phase: ["active","completed"]
			}
			bounds: {
				id: {sizeMin: 1, sizeMax: 128}
				seat: {sizeMin: 1, sizeMax: 64}
				revision: {intMin: 0}
				view: {kind: "object", fields: {"flipped":{"kind":"string","enumValues":["no","yes"]},"status":{"kind":"string","enumValues":["playing","fullscreen","login","completed"]}}}
			}
		}
	}
