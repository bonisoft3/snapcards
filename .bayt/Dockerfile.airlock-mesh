COPY --parents services/airlock/dapr/illustrate-card.yaml services/airlock/dapr/smollm3-draft.yaml services/airlock/dapr/heavy-draft.yaml services/airlock/dapr/print-quote.yaml services/airlock/dapr/print-quote-br.yaml services/airlock/dapr/print-fx.yaml services/airlock/dapr/print-session.yaml services/airlock/dapr/print-check.yaml services/airlock/dapr/print-place.yaml services/airlock/dapr/print-place-br.yaml services/airlock/dapr/print-status.yaml services/airlock/dapr/print-status-br.yaml services/airlock/dapr/print-confirm.yaml services/airlock/dapr/print-record.yaml services/airlock/dapr/print-shipped.yaml services/airlock/dapr/print-alert.yaml ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then { w=$(pwd); mkdir -p /.bayt-clamp && find "$w" -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a "$w" /.bayt-clamp/w && rm -rf "$w" && mv /.bayt-clamp/w "$w"; fi && rm -rf /.bayt-clamp; } && find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS airlock-mesh_srcs
COPY --from=airlock-mesh_ctxs /monorepo /monorepo

