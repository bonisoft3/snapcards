FROM alpine/curl@sha256:5bd4985f3daa6d1ca87619802190afc24c0ccd410b1f123de5afc8e891b5fc71 AS seed-blobs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY assets/seed/ /seed/
COPY --parents assets/seed/* ./
COPY .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/bayt.seed-blobs.json ./.bayt/
ENTRYPOINT ["/bin/sh", "-c", "for f in /seed/*; do case \"$f\" in *.webp) t=image/webp;; *.png) t=image/png;; *.jpg) t=image/jpeg;; *) echo \"no type for $f\"; exit 1;; esac; curl -fsS -o /dev/null -X PUT -H \"content-type: $t\" --data-binary \"@$f\" \"http://rclone-s3:3900/mecha-objects/seed/${f##*/}\" || exit 1; done"]

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS seed-blobs_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents assets/seed/* ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then { w=$(pwd); mkdir -p /.bayt-clamp && find "$w" -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a "$w" /.bayt-clamp/w && rm -rf "$w" && mv /.bayt-clamp/w "$w"; fi && rm -rf /.bayt-clamp; } && find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS seed-blobs_srcs
COPY --from=seed-blobs_ctxs /monorepo /monorepo

