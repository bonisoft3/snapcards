ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.airlock.yaml .bayt/Dockerfile.airlock .bayt/bayt.airlock.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
COPY --from=snapcards-airlock-mesh_bayt /monorepo /monorepo
