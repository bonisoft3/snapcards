      FROM pg_namespace n, aclexplode(n.nspacl) a
      WHERE n.nspname = ''''cortex_runtime'''' AND a.grantee <> n.nspowner
    UNION
    SELECT DISTINCT ''''TABLE'''', ''''cortex_runtime.'''' || quote_ident(c.relname), a.grantee
