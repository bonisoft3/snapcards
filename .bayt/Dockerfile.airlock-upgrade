  IF TG_OP = ''''INSERT'''' THEN
    DELETE FROM public.schedule WHERE emits_entity = ''''machine_timer_tick'''' AND emits_values @> jsonb_build_object(''''machine'''', ''''PrintOrderMachine'''', ''''row'''', jsonb_build_object(''''id'''', NEW."id"::text));
  END IF;
