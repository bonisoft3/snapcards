rail.png journal/2026-11-22-consent-bar-en-dark.png journal/2026-11-22-consent-bar-en-light.png journal/2026-11-22-consent-bar-gpc-shield.png journal/2026-11-22-consent-bar-pt-dark.png journal/2026-11-22-consent-bar-pt-light.png journal/2026-11-22-consent-bar-pt-phone.png journal/2026-11-22-consent-bar-reopened-en.png robots.txt sitemap.xml shell/favicon.svg shell/tag.html .well-known/assetlinks.json .well-known/apple-app-site-association ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then { w=$(pwd); mkdir -p /.bayt-clamp && find "$w" -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a "$w" /.bayt-clamp/w && rm -rf "$w" && mv /.bayt-clamp/w "$w"; fi && rm -rf /.bayt-clamp; } && find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS served_srcs
COPY --from=served_ctxs /monorepo /monorepo

FROM busybox:musl@sha256:03db190ed4c1ceb1c55d179a0940e2d71d42130636a780272629735893292223 AS served_bayt_ctxs
ARG BAYT_DIR
WORKDIR /monorepo/${BAYT_DIR}
COPY --parents .bayt/compose.served.yaml .bayt/Dockerfile.served .bayt/bayt.served.json .bayt/Taskfile.yml .bayt/Taskfile.bayt.yml .bayt/process-compose.yaml ./
ARG SOURCE_DATE_EPOCH
ARG BAYT_CLAMP=1
RUN if [ "${BAYT_CLAMP:-1}" != 0 ]; then { w=$(pwd); mkdir -p /.bayt-clamp && find "$w" -exec getfattr -dh {} + > /.bayt-clamp/x && if [ ! -s /.bayt-clamp/x ]; then cd / && cp -a "$w" /.bayt-clamp/w && rm -rf "$w" && mv /.bayt-clamp/w "$w"; fi && rm -rf /.bayt-clamp; } && find /monorepo/${BAYT_DIR} -exec touch -hd @${SOURCE_DATE_EPOCH:-0} {} + && { d=$(dirname /monorepo/${BAYT_DIR}); while [ "$d" != / ]; do touch -hd @${SOURCE_DATE_EPOCH:-0} "$d" || exit; d=$(dirname "$d"); done; }; fi
FROM scratch AS served_bayt
COPY --from=served_bayt_ctxs /monorepo /monorepo
